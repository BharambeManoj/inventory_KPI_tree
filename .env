# ==============================================================================
# BOSCH VM/LOG-IN INVENTORY KPI TREE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Strictly bind to localhost / 127.0.0.1 (Never 0.0.0.0 to avoid Bosch IN3-HTTP-05 proxy block)
HOST=127.0.0.1
PORT=5000

# Flask Session & Security Key
FLASK_SECRET_KEY=bosch-chakan-vm-login-inventory-kpi-tree-secret-key-2026

# Bypass Azure AD Authentication for now (Set to false later when enabling SSO)
AUTH_BYPASS_DEV=true

# Azure AD (MSAL) Configuration Placeholders (For future SSO rollout)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-azure-client-secret-placeholder
AZURE_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
AZURE_REDIRECT_URI=http://localhost:5000/getAToken

# Compulsory Excel Data Source Paths (Supports both root folder and ./data/ subfolder)
INVENTORY_ACTUAL_VS_FORECAST_PATH=./Inventory Actual Vs Forecast.xlsx
KPI_LOP3_PATH=./KPI LOP3.xlsx
